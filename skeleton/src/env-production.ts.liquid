import { App } from "aws-cdk-lib";
import { CognitoStack } from "./cognito-stack.js";

const app = new App();

new CognitoStack(app, "{{project.name}}-production", {
    env: {
        account: "{{awsEnv.accountId}}",
        region: "{{awsEnv.region}}",
    },
    envName: "production",
    domainPrefix: "{{domainPrefixes.production}}",
    fromAddress: {{ poolSettings.fromAddress | json }},
    // Set to true after the SES verification email has been confirmed (see README).
    useSes: false,
    // The SES identity is account-wide, so only one environment creates it.
    createEmailIdentity: {% if poolSettings.environments contains "staging" %}false{% else %}true{% endif %},
    {%- if spaSettings %}
    // Exact origins, no trailing slash. Replace the placeholder with the deployed app's origin
    // before the first production deploy.
    {{spaSettings.propPrefix}}Urls: ["https://example.com"],
    {%- endif %}
});

app.synth();
