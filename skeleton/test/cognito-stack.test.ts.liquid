import assert from "node:assert/strict";
import { describe, it } from "node:test";
import { App } from "aws-cdk-lib";
import { Match, Template } from "aws-cdk-lib/assertions";
import { CognitoStack } from "../src/cognito-stack.js";

const synth = (
    useSes: boolean,
    createEmailIdentity = true,
    sesVerifiedDomain?: string,
): Template => {
    const app = new App();
    const stack = new CognitoStack(app, "TestStack", {
        env: { account: "123456789012", region: "{{awsEnv.region}}" },
        envName: "test",
        domainPrefix: "test-prefix",
        fromAddress: "auth@example.com",
        useSes,
        createEmailIdentity,
        sesVerifiedDomain,
        {%- if spaSettings %}
        {{spaSettings.propPrefix}}Urls: ["http://localhost:3010"],
        {%- endif %}
    });

    return Template.fromStack(stack);
};

describe("CognitoStack", () => {
    it("keeps the user pool when the stack is deleted", () => {
        synth(false).hasResource("AWS::Cognito::UserPool", {
            DeletionPolicy: "Retain",
            UpdateReplacePolicy: "Retain",
        });
    });

    it("protects the user pool from deletion", () => {
        synth(false).hasResourceProperties("AWS::Cognito::UserPool", {
            DeletionProtection: "ACTIVE",
        });
    });

    {%- if poolSettings.mfa == "off" %}
    it("turns MFA off", () => {
        synth(false).hasResourceProperties("AWS::Cognito::UserPool", {
            MfaConfiguration: "OFF",
        });
    });
    {%- else %}
    it("uses an authenticator app for MFA", () => {
        synth(false).hasResourceProperties("AWS::Cognito::UserPool", {
            MfaConfiguration: "{% if poolSettings.mfa == "required" %}ON{% else %}OPTIONAL{% endif %}",
            EnabledMfas: ["SOFTWARE_TOKEN_MFA"],
        });
    });
    {%- endif %}

    it("only lets admins create users", () => {
        synth(false).hasResourceProperties("AWS::Cognito::UserPool", {
            AdminCreateUserConfig: { AllowAdminCreateUserOnly: true },
            Policies: { PasswordPolicy: Match.objectLike({ MinimumLength: 12 }) },
        });
    });

    it("creates an admin group", () => {
        synth(false).hasResourceProperties("AWS::Cognito::UserPoolGroup", {
            GroupName: "admin",
        });
    });

    it("uses Managed Login on the Cognito domain", () => {
        synth(false).hasResourceProperties("AWS::Cognito::UserPoolDomain", {
            Domain: "test-prefix",
            ManagedLoginVersion: 2,
        });
    });

    it("sends email through Cognito until SES is turned on", () => {
        synth(false).hasResourceProperties("AWS::Cognito::UserPool", {
            EmailConfiguration: { EmailSendingAccount: "COGNITO_DEFAULT" },
        });
        synth(true).hasResourceProperties("AWS::Cognito::UserPool", {
            EmailConfiguration: Match.objectLike({ EmailSendingAccount: "DEVELOPER" }),
        });
    });

    it("creates the SES identity when createEmailIdentity is true", () => {
        synth(false, true).hasResourceProperties("AWS::SES::EmailIdentity", {
            EmailIdentity: "auth@example.com",
        });
    });

    it("keeps the SES identity when the stack is deleted", () => {
        synth(false, true).hasResource("AWS::SES::EmailIdentity", {
            DeletionPolicy: "Retain",
            UpdateReplacePolicy: "Retain",
        });
    });

    it("skips the SES identity when createEmailIdentity is false", () => {
        synth(false, false).resourceCountIs("AWS::SES::EmailIdentity", 0);
    });

    it("sends through a verified domain without creating an address identity", () => {
        const template = synth(true, true, "example.com");

        template.resourceCountIs("AWS::SES::EmailIdentity", 0);

        // The ARN is an Fn::Join with the partition, so compare its serialized form.
        const [userPool] = Object.values(template.findResources("AWS::Cognito::UserPool"));
        const sourceArn = JSON.stringify(userPool?.Properties.EmailConfiguration.SourceArn);
        assert.match(sourceArn, /:identity\/example\.com"/);
    });

    it("keeps the old email until a new one is verified", () => {
        synth(false).hasResourceProperties("AWS::Cognito::UserPool", {
            UserAttributeUpdateSettings: { AttributesRequireVerificationBeforeUpdate: ["email"] },
        });
    });

    it("treats email sign-in as case-insensitive", () => {
        synth(false).hasResourceProperties("AWS::Cognito::UserPool", {
            UsernameConfiguration: { CaseSensitive: false },
        });
    });

    it("exports the issuer as the provider URL, which already starts with https://", () => {
        synth(false).hasOutput("Issuer", {
            Value: { "Fn::GetAtt": [Match.anyValue(), "ProviderURL"] },
        });
    });

    it("exports the outputs other projects rely on", () => {
        const template = synth(false);

        for (const name of ["UserPoolId", "UserPoolArn", "Issuer", "HostedDomain"]) {
            template.hasOutput(name, {});
        }
        {%- if spaSettings %}
        template.hasOutput("SpaClientId", {});
        {%- endif %}
        {%- if apiSettings %}
        template.hasOutput("ApiScope", {});
        {%- endif %}
    });
    {%- if spaSettings %}

    it("creates a public SPA client using the code flow", () => {
        synth(false).hasResourceProperties("AWS::Cognito::UserPoolClient", {
            GenerateSecret: false,
            AllowedOAuthFlows: ["code"],
            CallbackURLs: ["http://localhost:3010"],
            LogoutURLs: ["http://localhost:3010"],
            RefreshTokenRotation: Match.objectLike({ Feature: "ENABLED" }),
        });
    });

    it("allows no direct sign-in flows, so sign-in goes through Managed Login", () => {
        synth(false).hasResourceProperties("AWS::Cognito::UserPoolClient", {
            ExplicitAuthFlows: [],
        });
    });

    it("gives the SPA client a Managed Login style once the domain exists", () => {
        const template = synth(false);
        const [domainId] = Object.keys(template.findResources("AWS::Cognito::UserPoolDomain"));

        template.resourceCountIs("AWS::Cognito::ManagedLoginBranding", 1);
        template.hasResource("AWS::Cognito::ManagedLoginBranding", {
            DependsOn: Match.arrayWith([domainId]),
        });
    });
    {%- endif %}
    {%- if apiSettings %}

    it("creates the API resource server", () => {
        synth(false).hasResourceProperties("AWS::Cognito::UserPoolResourceServer", {
            Identifier: "{{apiSettings.identifier}}",
        });
    });
    {%- endif %}
});
